{
  "name": "frame-backend",
  "version": "1.0.0",
  "description": "FRAME backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "prebuild": "prisma generate --schema=prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "db:generate": "dotenv -e .env -- prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- prisma migrate dev --schema=prisma/schema.prisma",
    "db:push": "dotenv -e .env -- prisma db push --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.8.1",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.5",
    "dotenv-cli": "^7.3.0",
    "prisma": "^5.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
